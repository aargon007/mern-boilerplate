# Browser settings (VITE_* values are public and embedded at build time)
VITE_BASE_API=/api/v1
VITE_PORT=5173

# Local API
NODE_ENV=development
PORT=5001
DB_URI=mongodb://127.0.0.1:27017/myapp
CLIENT_ORIGIN=http://localhost:5173

# Replace both secrets before deployment
BCRYPT_SALT_ROUNDS=10
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ACCESS_SECRET=replace-with-a-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret

# Optional Compose overrides (defaults use the bundled MongoDB and frontend)
# DOCKER_DB_URI=mongodb://mongo:27017/myapp
# DOCKER_CLIENT_ORIGIN=http://localhost:4173
