{
    "name": "mern-turbo-boilerplate",
    "private": true,
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "build:frontend": "turbo run build --filter=frontend",
        "build:server": "turbo run build --filter=server",
        "start": "turbo run start",
        "start:frontend": "turbo run start --filter=frontend",
        "start:server": "turbo run start --filter=server",
        "lint": "turbo run lint",
        "format": "turbo run format",
        "upgrade:all": "pnpm up --recursive --latest",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test"
    },
    "keywords": [
        "MERN",
        "Boilerplate",
        "Turbo repo",
        "Mono repo",
        "React.js",
        "Mongodb",
        "Express.js",
        "Node.js"
    ],
    "author": "Md Muhaiminul",
    "devDependencies": {
        "prettier": "^3.9.10",
        "turbo": "^2.11.7"
    },
    "engines": {
        "node": "^22.18.0 || >=24.11.0"
    },
    "packageManager": "pnpm@9.0.0",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "9.0.0",
            "onFail": "error"
        }
    }
}
